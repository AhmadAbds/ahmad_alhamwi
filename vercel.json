{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "builds": [
    {
      "src": "public/**",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
    "outputDirectory": "public",
    "functions": {
        "api/lambda.php" : {
        "runtime" : "vercel-php@0.7.4"
    }
    },
    "rewrites": [
        {"source": "/(.*)" , "destination": "/api/lambda.php"}
    ]
    
}